# Copy this file to .env and replace the placeholder values on your machine.
# Do not commit the real DATABASE_URL.
# Percent-encode reserved characters in USERNAME or PASSWORD, such as @, :, /, ?, and #.
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME"
# A separate empty database used only by `prisma migrate dev`.
SHADOW_DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME_shadow"
