# Copy this file to .env and replace the placeholder values on your machine.
# Do not commit the real DATABASE_URL.
# Percent-encode reserved characters in USERNAME or PASSWORD, such as @, :, /, ?, and #.
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME"
# A separate empty database used only by `prisma migrate dev`.
SHADOW_DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME_shadow"

# Server-only Qwen configuration. Never expose these values through public runtime config.
QWEN_API_KEY="REPLACE_ME"
QWEN_BASE_URL="https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation"
QWEN_MODEL="qwen3.8-max"
# Connection and stream idle timeout; each upstream chunk resets this timer.
QWEN_TIMEOUT_MS="30000"
# 当前模型和账号确认支持时保持 true；设为 false 可隐藏深度思考开关。
QWEN_DEEP_THINKING_ENABLED="true"
# Set false to hide the web-search toggle and reject web-search requests server-side.
QWEN_WEB_SEARCH_ENABLED="true"

# Server-only Alibaba Cloud OSS configuration. Keep the Bucket private and never expose
# these credentials through public runtime config or frontend code.
ALI_OSS_BUCKET="jinyu-planet-assets"
ALI_OSS_REGION="cn-chengdu"
ALI_OSS_ENDPOINT="oss-cn-chengdu.aliyuncs.com"
ALI_OSS_ACCESS_KEY_ID="REPLACE_ME"
ALI_OSS_ACCESS_KEY_SECRET="REPLACE_ME"
